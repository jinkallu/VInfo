{
     "compilerOptions": {

        "module": "es6",
        "noImplicitAny": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "sourceMap": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        //"outDir": "../src/symvi/dist1",
        "target": "es6",
        "lib": [
            "es5", "es6", "dom", "dom.iterable"
        ],
        "types": [
                  "mathjax",
                  "three",
                  "node",
                  "node/fs"
                 ]
     },
     "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@types/node",
      "./node_modules/@types/node/ts3.2",
      "./"
     ]
 }